{
  "name": "messages",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:sync": "node scripts/contracts.mjs --sync",
    "test:contracts": "node --test tests/*.test.cjs",
    "test": "npm run test:node",
    "performance:report": "node scripts/frontend-performance.mjs",
    "test:node:native": "mkdir -p coverage && node --enable-source-maps --test --test-concurrency=1 --experimental-test-coverage --test-coverage-branches=60 --test-coverage-functions=60 --test-coverage-lines=60 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.cjs",
    "test:node": "node scripts/test-node-coverage.cjs"
  },
  "dependencies": {
    "@mairie360/bff-message-openapi": "0.0.0-dev.ad5339c36fb676e62e828894253dcd699df7c842",
    "@mairie360/front-kit": "file:vendor/mairie360-front-kit-0.1.0.tgz",
    "@mairie360/lib-components": "0.9.0",
    "axios": "1.20.0",
    "daisyui": "^5.0.0",
    "lucide-react": "^1.0.0",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "braces": "$braces",
    "next": {
      ".": "$next",
      "postcss": "^8.5.23",
      "sharp": "^0.35.5"
    }
  },
  "devDependencies": {
    "braces": "file:./vendor/braces",
    "@tailwindcss/postcss": "^4.0.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5"
  }
}
